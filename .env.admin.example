# Native PostgreSQL administration ONLY, used by scripts/create-readonly-role.py.
# Copy to .env.admin, chmod 600; never pass this file to the TMate service.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=teslamate
PGUSER=postgres
PGPASSWORD=REPLACE_WITH_DATABASE_ADMIN_PASSWORD
# Use verify-full and your CA for a remote TLS database. Never use public plaintext.
PGSSLMODE=prefer

# TMate server configuration. Copy to .env and chmod 600 .env.
# REQUIRED: fill these yourself. Do not use Tesla tokens or account passwords.
# Generate independent random values: openssl rand -hex 32
# URL-encode reserved characters in the database password (hex avoids this).
DATABASE_URL=postgresql://tmate_reader:CHANGE_ME@database:5432/teslamate
API_KEY=REPLACE_WITH_YOUR_64_HEX_RANDOM_KEY

# Public webpage origin, including non-standard port, without trailing slash.
# HTTPS example: https://tmate.example.com:8443
# Trusted LAN browser example: http://192.168.50.20:8787
WEB_ORIGIN=http://localhost:8787
ALLOWED_ORIGINS=capacitor://localhost,https://localhost

# OPTIONAL: AMap Web Service key (NOT JavaScript SDK key).
# Leave empty to disable road basemaps and AMap detailed Chinese addresses.
AMAP_KEY=
MQTT_URL=mqtt://mosquitto:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_PREFIX=teslamate

# Docker: join the EXISTING TeslaMate network; never recreate its database.
TESLAMATE_NETWORK=teslamate_default
# HTTP is loopback-only by default. Use your LAN IP only for a trusted LAN.
TMATE_BIND_ADDRESS=127.0.0.1
TMATE_HTTP_PORT=8787
# Optional Docker HTTPS profile: set these AND matching WEB_ORIGIN.
TMATE_DOMAIN=tmate.example.com
TMATE_HTTPS_BIND_ADDRESS=127.0.0.1
TMATE_HTTPS_PORT=8443

# Native deployment only. Replace database/mosquitto hostnames above with
# reachable addresses (usually 127.0.0.1). Docker overrides these runtime paths.
HOST=127.0.0.1
PORT=8787
PUBLIC_DIR=www
MAP_CACHE_DIR=./map-cache

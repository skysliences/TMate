{
  "name": "tmate",
  "version": "1.2.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:web": "node scripts/configure-mobile.mjs --check && vite build --config vite.mobile.config.ts",
    "mobile:sync": "node scripts/configure-mobile.mjs && npm run build:web && cap sync",
    "mobile:android": "cap open android",
    "android:apk": "node scripts/configure-mobile.mjs && npm run build:web && cap sync android && node scripts/build-android.mjs",
    "mobile:ios": "cap open ios",
    "mobile:icons": "node scripts/native-icons.mjs",
    "api": "node --env-file=.env server/index.mjs",
    "test": "node --experimental-strip-types --test --test-timeout=60000 server/*.test.mjs lib/*.test.ts scripts/*.test.mjs",
    "config:check": "node scripts/check-config.mjs .env",
    "package:source": "node scripts/package-source.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "gcoord": "1.0.7",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "mqtt": "^5.15.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260903.1",
    "@electric-sql/pglite": "^0.5.8",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.35.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}

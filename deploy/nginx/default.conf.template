# Optional Docker TLS profile. Certificate and private key stay on your server.
server {
    listen 8443 ssl;
    server_name ${TMATE_DOMAIN};
    ssl_certificate /etc/tmate/tls/cert.pem;
    ssl_certificate_key /etc/tmate/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log off;
    client_max_body_size 4k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    if ($host != ${TMATE_DOMAIN}) { return 421; }
    location / {
        set $backend http://tmate:8787;
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection '';
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}

# Build context is a release folder containing www/ and server/.
# The frontend is built on the development machine to reduce NAS resource use.
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 PUBLIC_DIR=/app/www
COPY server/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=node:node server/index.mjs server/config.mjs server/domain.mjs server/address-label.mjs server/maps.mjs server/map-geometry.mjs server/mqtt.mjs server/queries.mjs server/sessions.mjs ./server/
COPY --chown=node:node server/software.mjs server/mqtt-cache.mjs ./server/
COPY --chown=node:node deploy/smoke.mjs ./deploy/smoke.mjs
COPY --chown=node:node deploy/pair-device.mjs ./deploy/pair-device.mjs
COPY --chown=node:node scripts/check-config.mjs ./scripts/check-config.mjs
COPY --chown=node:node www/ ./www/
RUN install -d -o node -g node -m 700 /app/data
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server/index.mjs"]

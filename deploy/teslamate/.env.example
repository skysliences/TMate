# TeslaMate prerequisite installer. Copy to .env IN THIS directory.
# Fill every secret yourself. Use distinct values: openssl rand -hex 32
# Do not change ENCRYPTION_KEY after Tesla tokens have been stored.
ENCRYPTION_KEY=REPLACE_WITH_YOUR_64_HEX_ENCRYPTION_KEY
DATABASE_PASS=REPLACE_WITH_YOUR_DATABASE_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_YOUR_GRAFANA_PASSWORD

TESLAMATE_PROJECT_NAME=teslamate
TESLAMATE_NETWORK=teslamate_default
# Pinned, tested schema baseline. Upgrade explicitly using upstream instructions.
TESLAMATE_VERSION=4.2.0
GRAFANA_VERSION=4.2.0
POSTGRES_VERSION=18-trixie
MOSQUITTO_VERSION=2
DATABASE_USER=teslamate
DATABASE_NAME=teslamate
TM_BIND_ADDRESS=127.0.0.1
TESLAMATE_PORT=4000
GRAFANA_PORT=3000
TESLAMATE_HOSTNAME=localhost
TZ=Asia/Shanghai
# Global Tesla endpoints. For China accounts see docs/deployment.md.
TESLA_API_HOST=owner-api.teslamotors.com
TESLA_WSS_HOST=streaming.vn.teslamotors.com
